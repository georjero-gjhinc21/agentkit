# Copy to .env and fill in whichever provider you use.
# Only the examples that talk to a real model need these; examples 01-04 and
# 06 run entirely offline with FakeModel.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Point at a local OpenAI-compatible server (vLLM, Ollama, LM Studio) instead:
# OPENAI_BASE_URL=http://localhost:11434/v1
